  bibsource    = {dblp computer science bibliography, https://dblp.org},

  abbr={WWW 23},
  pdf={www23.pdf},
  selected={true}
}

@inproceedings{10.1145/3717823.3718156,
author = {Gravin, Nikolai and Jia, Jianhao},
title = {Approximation Guarantees of Median Mechanism in ℝᵈ},
year = {2025},
isbn = {9798400715105},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA}, url = {https://doi.org/10.1145/3717823.3718156},
doi = {10.1145/3717823.3718156},
abstract = {The coordinate-wise median is a classic and most well-studied strategy-proof mechanism in social choice and facility location scenarios. Surprisingly, there is no systematic study of its approximation ratio in d-dimensional spaces. The best known approximation guarantee in d-dimensional Euclidean space L2(ℝd) is √d via a simple argument of embedding L1(ℝd) into L2(ℝd) metric space, that only appeared in appendix of [Meir 2019]. This upper bound is known to be tight in dimension d=2 from [Goel and Hann-Caruthers 2023], but there are no known super constant lower bounds. A few recent papers on mechanism design with predictions (e.g., [Agrawal, Balkanski, Gkatzelis, Ou, Tan 2022], [Christodoulou, Sgouritsa, Vlachos 2024], and [Barak, Gupta, Talgam-Cohen 2024]) directly rely on the √d-approximation result. In this paper, we systematically study approximate efficiency of the coordinate-median in Lq(ℝd) spaces for any Lq norm with q∈[1,∞] and any dimension d. We derive a series of constant upper bounds UB(q) independent of the dimension d. This series UB(q) is growing with parameter q, but never exceeds the constant UB(∞)= 3. Our bound UB(2)=√6√3−8<1.55 for L2 norm is only slightly worse than the tight approximation guarantee of √2>1.41 in dimension d=2. Furthermore, we show that our upper bounds are essentially tight by giving almost matching lower bounds LB(q,d)=UB(q)·(1−O(1/d)) for any dimension d with LB(q,d)=UB(q) when d→∞. We also extend our analysis to the generalized median mechanism used in [Agrawal, Balkanski, Gkatzelis, Ou, Tan 2022] for L2(ℝ2) space to arbitrary dimensions d with similar results for both robustness and consistency approximation guarantees.},
booktitle = {Proceedings of the 57th Annual ACM Symposium on Theory of Computing},
pages = {495–506},
numpages = {12},
keywords = {Facility Location Games, Mechanism Design without Money, Median Mechanism},
location = {Prague, Czechia},
series = {STOC '25} 
abbr={STOC 25},
selected={true}
}
